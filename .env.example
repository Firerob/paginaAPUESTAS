# ---------------------------------------------------------------------------
# Copia este archivo a .env y ajusta los valores.
# ---------------------------------------------------------------------------

# Base de datos.
# Si ya tienes otro Postgres ocupando el 5432, cambia POSTGRES_PORT y el puerto
# de DATABASE_URL a la vez (p.ej. 5433).
POSTGRES_PORT=5432
DATABASE_URL=postgres://airhockey:airhockey@localhost:5432/airhockey
# En Postgres administrado (Render, RDS, etc.) hace falta TLS: pon esto en
# "true" en el entorno de hosting. En local, dejalo vacio/false.
DATABASE_SSL=false

# Secreto de firma de tokens de sesion.
# El servidor de juego y el emisor de tokens (Next.js en dev) deben compartirlo.
# En produccion usa un par de llaves asimetricas (RS256) y rota periodicamente.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-min-32-chars
JWT_ISSUER=airhockey-auth
JWT_AUDIENCE=airhockey-game

# Game server
# GAME_SERVER_PORT es el default local; en Render el puerto real llega por
# la variable PORT que el propio Render inyecta (no hay que tocarla).
GAME_SERVER_PORT=2567
# Uno o varios origenes separados por coma (ej. lobby local + GitHub Pages).
GAME_SERVER_ORIGIN=http://localhost:3000
# Opcional: un origen suelto adicional, se suma a la lista de arriba (por si
# el hosting del front ya te da esta variable de por si en vez de una lista).
# CLIENT_URL=https://firerob.github.io

# Economia (valores en pesos colombianos enteros, sin centavos)
STAKE_COP=1000
RAKE_BPS=500

# Cuenta de sistema que acumula la comision. Se siembra en 002_seed_dev.sql
HOUSE_USER_ID=00000000-0000-0000-0000-0000000000ff

# Frontend. Socket.io negocia el WebSocket sobre esta misma URL.
NEXT_PUBLIC_GAME_SERVER_HTTP=http://localhost:2567
